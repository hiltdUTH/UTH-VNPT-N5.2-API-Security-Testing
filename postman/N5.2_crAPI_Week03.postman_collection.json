      "name": "01_Signup_User_B",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dang ky tai khoan gia lap thanh cong (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User B\",\n  \"email\": \"user_b@example.com\",\n  \"number\": \"9876543211\",\n  \"password\": \"LabPass@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/identity/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "identity",
            "api",
            "auth",
            "signup"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02_Login_User_A_Get_JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Dang nhap thanh cong (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "    pm.test('Tra ve va tu dong luu JWT token', function () {",
              "        pm.expect(jsonData.token).to.be.a('string').and.not.be.empty;",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user_a@example.com\",\n  \"password\": \"LabPass@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/identity/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "identity",
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
